#!/usr/bin/env bash
# VFlasher - flash alternate OS images onto Qualcomm and Arduino boards.
#
# Usage: sudo vflasher <board-manufacturer> <board-name> <os> [options]
#
# Unofficial personal project; not affiliated with Qualcomm or Arduino.

set -euo pipefail

VFLASHER_VERSION="0.1.0"
REMOTE_IMAGES_URL="${VFLASHER_REMOTE:-https://raw.githubusercontent.com/developer1-vd/QC-and-Arduino-noubuntu/main/images}"

die()  { printf 'vflasher: error: %s\n' "$*" >&2; exit 1; }
info() { printf '==> %s\n' "$*"; }
warn() { printf 'vflasher: warning: %s\n' "$*" >&2; }

usage() {
    cat <<EOF
VFlasher ${VFLASHER_VERSION}

Usage:
  sudo vflasher <board-manufacturer> <board-name> <os> [options]
  vflasher --list

Examples:
  sudo vflasher qualcomm iq9075-evk fedora
  sudo vflasher qualcomm iq9075-evk fedora --device /dev/sdb

Options:
  -d, --device DEV    Block device to write (whole disk, e.g. /dev/sdb).
                      If omitted, VFlasher lists drives and asks.
  -y, --yes           Do not ask for confirmation before writing.
      --download-only Download and verify the image, but do not flash.
      --info          Show the image details and exit.
  -l, --list          List available images and exit.
  -h, --help          Show this help.
  -V, --version       Show the version.

Environment:
  VFLASHER_IMAGES     Local images directory (default: next to this script).
  VFLASHER_CACHE      Download cache (default: ~/.cache/vflasher).
EOF
}

# ---------------------------------------------------------------- locations

script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [ -L "$src" ]; do
        local dir; dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}

images_dir() {
    if [ -n "${VFLASHER_IMAGES:-}" ]; then
        printf '%s\n' "$VFLASHER_IMAGES"
    elif [ -d "$(script_dir)/images" ]; then
        printf '%s\n' "$(script_dir)/images"
    fi
}

cache_dir() {
    if [ -n "${VFLASHER_CACHE:-}" ]; then
        printf '%s\n' "$VFLASHER_CACHE"
        return
    fi
    # Under sudo, keep downloads in the invoking user's cache, not root's.
    local home="$HOME"
    if [ -n "${SUDO_USER:-}" ]; then
        home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    fi
    printf '%s\n' "${XDG_CACHE_HOME:-$home/.cache}/vflasher"
}

# --------------------------------------------------------------- manifests

declare -A CONF=()
CONF_PATH=""     # manifest found by find_conf
REMOTE_CONF=0    # 1 if CONF_PATH is a downloaded temp file

# Parse KEY=value lines without executing anything.
load_conf() {
    local file="$1" line key val
    CONF=()
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        [[ $line == *=* ]] || die "bad line in $file: $line"
        key="${line%%=*}"; val="${line#*=}"
        [[ $key =~ ^[A-Z0-9_]+$ ]] || die "bad key in $file: $key"
        CONF[$key]="$val"
    done < "$file"
    for key in NAME IMAGE_URL IMAGE_FILE IMAGE_SHA256 IMAGE_FORMAT FLASH_METHOD; do
        [ -n "${CONF[$key]:-}" ] || die "$file is missing $key"
    done
    [[ ${CONF[IMAGE_FILE]} =~ ^[A-Za-z0-9._+-]+$ ]] || die "unsafe IMAGE_FILE in $file"
    [[ ${CONF[IMAGE_SHA256]} =~ ^[0-9a-f]{64}$ ]] || die "bad IMAGE_SHA256 in $file"
}

valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9._-]*$ ]]; }

# Set CONF_PATH to a local copy of the manifest for manufacturer/board/os.
find_conf() {
    local rel="$1/$2/$3/image.conf" dir
    dir="$(images_dir)"
    if [ -n "$dir" ] && [ -f "$dir/$rel" ]; then
        CONF_PATH="$dir/$rel"
        return
    fi
    if [ -n "$dir" ]; then
        die "no image for '$1 $2 $3' (run 'vflasher --list')"
    fi
    # Installed standalone (e.g. in ~/.bin): fetch the manifest from GitHub.
    need curl
    CONF_PATH="$(mktemp)"; REMOTE_CONF=1
    info "Fetching image manifest for $1/$2/$3"
    curl -fsSL "$REMOTE_IMAGES_URL/$rel" -o "$CONF_PATH" \
        || { rm -f "$CONF_PATH"; die "no image for '$1 $2 $3' found online"; }
}

list_images() {
    local dir; dir="$(images_dir)"
    [ -n "$dir" ] || die "images directory not found; set VFLASHER_IMAGES or run from the repository"
    printf '%-14s %-16s %-10s %s\n' MANUFACTURER BOARD OS NAME
    local f rel
    while IFS= read -r f; do
        rel="${f#"$dir"/}"
        IFS=/ read -r m b o _ <<<"$rel"
        load_conf "$f"
        printf '%-14s %-16s %-10s %s\n' "$m" "$b" "$o" "${CONF[NAME]}"
    done < <(find "$dir" -mindepth 4 -maxdepth 4 -name image.conf | sort)
}

show_info() {
    local k
    for k in NAME OS_VERSION ARCH IMAGE_URL IMAGE_SHA256 IMAGE_SIZE IMAGE_FORMAT FLASH_METHOD DTB; do
        [ -n "${CONF[$k]:-}" ] && printf '%-13s %s\n' "$k" "${CONF[$k]}"
    done
}

# ---------------------------------------------------------------- download

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed"; }

sha256_ok() { [ "$(sha256sum "$1" | cut -d' ' -f1)" = "$2" ]; }

fetch_image() {
    local cache file part
    cache="$(cache_dir)"
    mkdir -p "$cache"
    file="$cache/${CONF[IMAGE_FILE]}"
    part="$file.part"

    if [ -f "$file" ]; then
        info "Verifying cached image $file" >&2
        if sha256_ok "$file" "${CONF[IMAGE_SHA256]}"; then
            printf '%s\n' "$file"; return
        fi
        warn "cached image failed verification; downloading again"
        rm -f "$file"
    fi

    need curl
    info "Downloading ${CONF[IMAGE_URL]}" >&2
    curl -fL --retry 3 -C - --progress-bar -o "$part" "${CONF[IMAGE_URL]}" >&2 \
        || die "download failed (re-run to resume)"

    info "Verifying SHA-256" >&2
    if ! sha256_ok "$part" "${CONF[IMAGE_SHA256]}"; then
        rm -f "$part"
        die "checksum mismatch for ${CONF[IMAGE_FILE]}; refusing to flash"
    fi
    mv "$part" "$file"
    # Hand the cache back to the invoking user when run under sudo.
    if [ -n "${SUDO_USER:-}" ] && [ -z "${VFLASHER_CACHE:-}" ]; then
        chown -R "$SUDO_USER": "$cache" 2>/dev/null || true
    fi
    printf '%s\n' "$file"
}

decompress_cmd() {
    case "${CONF[IMAGE_FORMAT]}" in
        raw)     echo "cat" ;;
        raw.xz)  need xz;   echo "xz -dc" ;;
        raw.gz)  need gzip; echo "gzip -dc" ;;
        raw.zst) need zstd; echo "zstd -dc" ;;
        *) die "unsupported IMAGE_FORMAT '${CONF[IMAGE_FORMAT]}'" ;;
    esac
}

# ------------------------------------------------------------------- flash

# ask PROMPT VAR - read an answer from the terminal (or stdin if there is none).
ask() {
    local _ans=""
    if { : </dev/tty; } 2>/dev/null; then
        read -r -p "$1" _ans </dev/tty || true
    else
        read -r -p "$1" _ans || true
    fi
    printf -v "$2" '%s' "$_ans"
}

list_disks() {
    lsblk -dpno NAME,SIZE,TRAN,MODEL -e 7,11 2>/dev/null || true
}

pick_device() {
    echo "Available drives:" >&2
    list_disks | sed 's/^/  /' >&2
    local dev=""
    ask "Device to write (e.g. /dev/sdb): " dev
    printf '%s\n' "$dev"
}

check_device() {
    local dev="$1"
    [ -b "$dev" ] || die "$dev is not a block device"
    case "$(lsblk -dno TYPE "$dev")" in disk|loop) ;; *) false ;; esac || die "$dev is not a whole disk (give e.g. /dev/sdb, not /dev/sdb1)"

    local root_src root_disk
    root_src="$(findmnt -no SOURCE / 2>/dev/null || true)"
    if [ -n "$root_src" ] && [ -b "$root_src" ]; then
        root_disk="$(lsblk -no PKNAME "$root_src" 2>/dev/null | head -n1)"
        [ "$dev" = "/dev/$root_disk" ] && die "$dev holds the running system; refusing"
    fi

    if lsblk -no MOUNTPOINTS "$dev" 2>/dev/null | grep -q .; then
        die "$dev has mounted partitions; unmount them first"
    fi
}

flash_dd() {
    local image="$1" dev="$2" unpack
    unpack="$(decompress_cmd)"
    info "Writing ${CONF[NAME]} to $dev"
    # shellcheck disable=SC2086
    $unpack "$image" | dd of="$dev" bs=4M iflag=fullblock conv=fsync oflag=direct status=progress
    sync
    command -v partprobe >/dev/null 2>&1 && partprobe "$dev" 2>/dev/null || true
    info "Done. $dev now holds ${CONF[NAME]}."
}

# -------------------------------------------------------------------- main

main() {
    local device="" assume_yes=0 download_only=0 info_only=0
    local -a pos=()

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)       usage; exit 0 ;;
            -V|--version)    echo "vflasher $VFLASHER_VERSION"; exit 0 ;;
            -l|--list)       list_images; exit 0 ;;
            -d|--device)     [ $# -ge 2 ] || die "$1 needs an argument"; device="$2"; shift ;;
            --device=*)      device="${1#*=}" ;;
            -y|--yes)        assume_yes=1 ;;
            --download-only) download_only=1 ;;
            --info)          info_only=1 ;;
            -*)              die "unknown option $1 (see --help)" ;;
            *)               pos+=("$(tr '[:upper:]' '[:lower:]' <<<"$1")") ;;
        esac
        shift
    done

    [ ${#pos[@]} -eq 3 ] || { usage >&2; exit 2; }
    local p
    for p in "${pos[@]}"; do valid_name "$p" || die "invalid name '$p'"; done

    find_conf "${pos[@]}"
    load_conf "$CONF_PATH"
    if [ "$REMOTE_CONF" -eq 1 ]; then rm -f "$CONF_PATH"; fi

    if [ "$info_only" -eq 1 ]; then show_info; exit 0; fi

    [ "${CONF[FLASH_METHOD]}" = dd ] \
        || die "flash method '${CONF[FLASH_METHOD]}' is not supported by this VFlasher version"

    if [ "$download_only" -eq 0 ] && [ "$(id -u)" -ne 0 ]; then
        die "flashing needs root; run with sudo (or use --download-only)"
    fi

    need sha256sum
    info "${CONF[NAME]}"

    # Pick and check the target before a possibly long download.
    if [ "$download_only" -eq 0 ]; then
        need lsblk; need dd
        [ -n "$device" ] || device="$(pick_device)"
        [ -n "$device" ] || die "no device given"
        check_device "$device"
    fi

    local image; image="$(fetch_image)"
    if [ "$download_only" -eq 1 ]; then
        info "Image verified: $image"
        exit 0
    fi

    if [ "$assume_yes" -eq 0 ]; then
        echo
        lsblk -po NAME,SIZE,TYPE,MODEL "$device"
        echo
        echo "ALL DATA ON $device WILL BE DESTROYED."
        local answer=""
        ask "Type the device name ($device) to continue: " answer
        [ "$answer" = "$device" ] || die "aborted"
    fi

    flash_dd "$image" "$device"
}

main "$@"
