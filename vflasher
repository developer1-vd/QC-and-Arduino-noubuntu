#!/usr/bin/env bash
# VFlasher - flash alternate OS images onto Qualcomm and Arduino boards.
#
# Usage: sudo vflasher <board-manufacturer> <board-name> <os> [options]
#
# Unofficial personal project; not affiliated with Qualcomm or Arduino.

set -euo pipefail

VFLASHER_VERSION="0.1.0"
REMOTE_IMAGES_URL="${VFLASHER_REMOTE:-https://raw.githubusercontent.com/developer1-vd/QC-and-Arduino-noubuntu/main/images}"

die()  { printf 'vflasher: error: %s\n' "$*" >&2; exit 1; }
info() { printf '==> %s\n' "$*"; }
warn() { printf 'vflasher: warning: %s\n' "$*" >&2; }

usage() {
    cat <<EOF
VFlasher ${VFLASHER_VERSION}

Usage:
  sudo vflasher <board-manufacturer> <board-name> <os> [options]
  vflasher --list

Examples:
  sudo vflasher qualcomm iq9075-evk fedora
  sudo vflasher qualcomm iq9075-evk fedora --device /dev/sdb
  sudo vflasher arduino ventuno-q fedora

Options:
  -d, --device DEV    Block device to write (whole disk, e.g. /dev/sdb).
                      If omitted, VFlasher lists drives and asks.
                      Not used for boards flashed over USB in EDL mode.
  -y, --yes           Do not ask for confirmation before writing.
      --cache DIR     Keep downloads and work files in DIR (needs ~15 GB free
                      for the biggest images). Default: ~/.cache/vflasher.
      --download-only Download and verify the image, but do not flash.
      --info          Show the image details and exit.
  -l, --list          List available images and exit.
  -h, --help          Show this help.
  -V, --version       Show the version.

Environment:
  VFLASHER_IMAGES     Local images directory (default: next to this script).
  VFLASHER_CACHE      Download cache (default: ~/.cache/vflasher).
  VFLASHER_QDL        qdl program for EDL flashing (default: qdl).
EOF
}

# ---------------------------------------------------------------- locations

script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [ -L "$src" ]; do
        local dir; dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}

images_dir() {
    if [ -n "${VFLASHER_IMAGES:-}" ]; then
        printf '%s\n' "$VFLASHER_IMAGES"
    elif [ -d "$(script_dir)/images" ]; then
        printf '%s\n' "$(script_dir)/images"
    fi
}

cache_dir() {
    if [ -n "${VFLASHER_CACHE:-}" ]; then
        printf '%s\n' "$VFLASHER_CACHE"
        return
    fi
    # Under sudo, keep downloads in the invoking user's cache, not root's.
    local home="$HOME"
    if [ -n "${SUDO_USER:-}" ]; then
        home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    fi
    printf '%s\n' "${XDG_CACHE_HOME:-$home/.cache}/vflasher"
}

# --------------------------------------------------------------- manifests

declare -A CONF=()
CONF_PATH=""     # manifest found by find_conf
REMOTE_CONF=0    # 1 if CONF_PATH is a downloaded temp file

# Parse KEY=value lines without executing anything.
load_conf() {
    local file="$1" line key val
    CONF=()
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        [[ $line == *=* ]] || die "bad line in $file: $line"
        key="${line%%=*}"; val="${line#*=}"
        [[ $key =~ ^[A-Z0-9_]+$ ]] || die "bad key in $file: $key"
        CONF[$key]="$val"
    done < "$file"
    for key in NAME IMAGE_URL IMAGE_FILE IMAGE_SHA256 IMAGE_FORMAT FLASH_METHOD; do
        [ -n "${CONF[$key]:-}" ] || die "$file is missing $key"
    done
    [[ ${CONF[IMAGE_FILE]} =~ ^[A-Za-z0-9._+-]+$ ]] || die "unsafe IMAGE_FILE in $file"
    [[ ${CONF[IMAGE_SHA256]} =~ ^[0-9a-f]{64}$ ]] || die "bad IMAGE_SHA256 in $file"
}

valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9._-]*$ ]]; }

# Set CONF_PATH to a local copy of the manifest for manufacturer/board/os.
find_conf() {
    local rel="$1/$2/$3/image.conf" dir
    dir="$(images_dir)"
    if [ -n "$dir" ] && [ -f "$dir/$rel" ]; then
        CONF_PATH="$dir/$rel"
        return
    fi
    if [ -n "$dir" ]; then
        die "no image for '$1 $2 $3' (run 'vflasher --list')"
    fi
    # Installed standalone (e.g. in ~/.bin): fetch the manifest from GitHub.
    need curl
    CONF_PATH="$(mktemp)"; REMOTE_CONF=1
    info "Fetching image manifest for $1/$2/$3"
    curl -fsSL "$REMOTE_IMAGES_URL/$rel" -o "$CONF_PATH" \
        || { rm -f "$CONF_PATH"; die "no image for '$1 $2 $3' found online"; }
}

list_images() {
    local dir; dir="$(images_dir)"
    [ -n "$dir" ] || die "images directory not found; set VFLASHER_IMAGES or run from the repository"
    printf '%-14s %-16s %-10s %s\n' MANUFACTURER BOARD OS NAME
    local f rel
    while IFS= read -r f; do
        rel="${f#"$dir"/}"
        IFS=/ read -r m b o _ <<<"$rel"
        load_conf "$f"
        printf '%-14s %-16s %-10s %s\n' "$m" "$b" "$o" "${CONF[NAME]}"
    done < <(find "$dir" -mindepth 4 -maxdepth 4 -name image.conf | sort)
}

show_info() {
    local k
    for k in NAME OS_VERSION ARCH IMAGE_URL IMAGE_SHA256 IMAGE_SIZE IMAGE_FORMAT FLASH_METHOD DTB; do
        [ -n "${CONF[$k]:-}" ] && printf '%-13s %s\n' "$k" "${CONF[$k]}"
    done
}

# ---------------------------------------------------------------- download

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed"; }

sha256_ok() { [ "$(sha256sum "$1" | cut -d' ' -f1)" = "$2" ]; }

fetch_image() {
    local cache file part
    cache="$(cache_dir)"
    mkdir -p "$cache"
    file="$cache/${CONF[IMAGE_FILE]}"
    part="$file.part"

    if [ -f "$file" ]; then
        info "Verifying cached image $file" >&2
        if sha256_ok "$file" "${CONF[IMAGE_SHA256]}"; then
            printf '%s\n' "$file"; return
        fi
        warn "cached image failed verification; downloading again"
        rm -f "$file"
    fi

    need curl
    info "Downloading ${CONF[IMAGE_URL]}" >&2
    curl -fL --retry 3 -C - --progress-bar -o "$part" "${CONF[IMAGE_URL]}" >&2 \
        || die "download failed (re-run to resume)"

    info "Verifying SHA-256" >&2
    if ! sha256_ok "$part" "${CONF[IMAGE_SHA256]}"; then
        rm -f "$part"
        die "checksum mismatch for ${CONF[IMAGE_FILE]}; refusing to flash"
    fi
    mv "$part" "$file"
    # Hand the cache back to the invoking user when run under sudo.
    if [ -n "${SUDO_USER:-}" ] && [ -z "${VFLASHER_CACHE:-}" ]; then
        chown -R "$SUDO_USER": "$cache" 2>/dev/null || true
    fi
    printf '%s\n' "$file"
}

decompress_cmd() {
    case "${CONF[IMAGE_FORMAT]}" in
        raw)     echo "cat" ;;
        raw.xz)  need xz;   echo "xz -dc" ;;
        raw.gz)  need gzip; echo "gzip -dc" ;;
        raw.zst) need zstd; echo "zstd -dc" ;;
        *) die "unsupported IMAGE_FORMAT '${CONF[IMAGE_FORMAT]}'" ;;
    esac
}

# ------------------------------------------------------------------- flash

# ask PROMPT VAR - read an answer from the terminal (or stdin if there is none).
ask() {
    local _ans=""
    if { : </dev/tty; } 2>/dev/null; then
        read -r -p "$1" _ans </dev/tty || true
    else
        read -r -p "$1" _ans || true
    fi
    printf -v "$2" '%s' "$_ans"
}

list_disks() {
    lsblk -dpno NAME,SIZE,TRAN,MODEL -e 7,11 2>/dev/null || true
}

pick_device() {
    echo "Available drives:" >&2
    list_disks | sed 's/^/  /' >&2
    local dev=""
    ask "Device to write (e.g. /dev/sdb): " dev
    printf '%s\n' "$dev"
}

check_device() {
    local dev="$1"
    [ -b "$dev" ] || die "$dev is not a block device"
    case "$(lsblk -dno TYPE "$dev")" in disk|loop) ;; *) false ;; esac || die "$dev is not a whole disk (give e.g. /dev/sdb, not /dev/sdb1)"

    local root_src root_disk
    root_src="$(findmnt -no SOURCE / 2>/dev/null || true)"
    if [ -n "$root_src" ] && [ -b "$root_src" ]; then
        root_disk="$(lsblk -no PKNAME "$root_src" 2>/dev/null | head -n1)"
        [ "$dev" = "/dev/$root_disk" ] && die "$dev holds the running system; refusing"
    fi

    if lsblk -no MOUNTPOINTS "$dev" 2>/dev/null | grep -q .; then
        die "$dev has mounted partitions; unmount them first"
    fi
}

flash_dd() {
    local image="$1" dev="$2" unpack
    unpack="$(decompress_cmd)"
    info "Writing ${CONF[NAME]} to $dev"
    # shellcheck disable=SC2086
    $unpack "$image" | dd of="$dev" bs=4M iflag=fullblock conv=fsync oflag=direct status=progress
    sync
    command -v partprobe >/dev/null 2>&1 && partprobe "$dev" 2>/dev/null || true
    info "Done. $dev now holds ${CONF[NAME]}."
}

# --------------------------------------------------------- qdl (EDL) flash
#
# Boards such as the Arduino VENTUNO Q boot only from on-board eMMC, which is
# written over USB in Qualcomm EDL mode with qdl. The eMMC starts with dozens
# of firmware partitions (bootloaders, UEFI, ...) that must not be touched.
# VFlasher reads the board's own partition table, keeps every firmware
# partition as it is, and only rearranges the OS partitions at the end:
#
#   before:  [firmware ...] [efi] [persist] [system ..................]
#   after:   [firmware ...] [efi] [persist] [boot] [system ............]
#
# The image's EFI, /boot and root partitions go into efi, boot and system.

QDL="${VFLASHER_QDL:-qdl}"

# Partition-table and image helper, run with python3. Subcommands:
#   split OUTDIR        raw disk image on stdin -> OUTDIR/p1.img ... (sparse);
#                       prints "pN START SECTORS" per partition
#   plan GPT ESP ROOT BOOT_SECTORS ESP_MIN ROOT_MIN ROOT_TYPE OUTDIR
#                       board GPT (34 sectors) -> OUTDIR/gpt-main.bin and
#                       gpt-backup.bin; prints KEY VALUE lines
#   lun-plan GPT SECTOR_SIZE ESP_BYTES BOOT_BYTES ROOT_BYTES OUTDIR
#                       a fresh GPT for a whole LUN (efi, boot, system), sized
#                       from the LUN's current GPT header; prints KEY VALUE lines
#   find-fs FILE        locate the file system inside a partition (e.g. in an
#                       LVM volume); prints "TYPE OFFSET BYTES UUID LABEL
#                       SECTOR" (XFS/btrfs sector size, ext4 block size)
read -r -d '' PY_HELPER <<'PY' || true
import re, struct, sys, uuid, zlib

SECTOR = 512
MIB = 1 << 20
ESP_TYPE = uuid.UUID("c12a7328-f81f-11d2-ba4b-00a0c93ec93b")
XBOOTLDR_TYPE = uuid.UUID("bc13c2ff-59e6-4262-a352-b275fd6f7172")
LVM_TYPE = uuid.UUID("e6d6d379-f507-44c2-a23c-238f2a3df928")
LINUX_TYPE = uuid.UUID("0fc63daf-8483-4772-8e79-3d69d8477de4")
ROOT_ARM64_TYPE = uuid.UUID("b921b045-1df0-41c3-af44-4c6f280d3fae")
# Qualcomm firmware partitions: a LUN holding any of these is never replaced.
FIRMWARE_RE = re.compile(r"^(xbl|xbl_config|xbl_ramdump|uefi|uefisecapp|tz|hyp|aop|cdt|ddr|devcfg|abl|"
                         r"keymaster|shrm|cpucp|qupfw|multiimgoem|multiimgqti|imagefv|dtb|sail\w*|SAIL\w*)(_[ab])?$")
HDR = struct.Struct("<8sIIIIQQQQ16sQIII")
ENT = struct.Struct("<16s16sQQQ72s")


def fail(msg):
    sys.exit("vflasher: error: " + msg)


class Reader:
    """Sequential reader over stdin with a little look-back for the header."""

    def __init__(self, f):
        self.f, self.pos = f, 0

    def read(self, n):
        out = bytearray()
        while len(out) < n:
            b = self.f.read(n - len(out))
            if not b:
                fail("the image ended before its last partition")
            out += b
        self.pos += n
        return bytes(out)

    def skip_to(self, pos):
        while self.pos < pos:
            self.read(min(MIB, pos - self.pos))


def image_partitions(head):
    """Partitions (start, sectors) of an MBR or GPT disk image."""
    if head[510:512] != b"\x55\xaa":
        fail("the image has no partition table")
    mbr = [struct.unpack_from("<B3xB3xII", head, 446 + 16 * i) for i in range(4)]
    if any(t == 0xEE for _, t, _, _ in mbr):
        h = HDR.unpack_from(head, SECTOR)
        if h[0] != b"EFI PART":
            fail("bad GPT in image")
        parts = []
        for i in range(h[11]):
            e = ENT.unpack_from(head, h[10] * SECTOR + i * h[12])
            if e[0] != bytes(16):
                parts.append((e[2], e[3] - e[2] + 1))
        return sorted(parts)
    return sorted((s, n) for _, t, s, n in mbr if t != 0 and n > 0)


def split(outdir):
    src = Reader(sys.stdin.buffer)
    head = src.read(MIB)
    parts = image_partitions(head)
    zero = bytes(MIB)
    for i, (start, sectors) in enumerate(parts, 1):
        if start * SECTOR < src.pos:
            fail("overlapping partitions in image")
        src.skip_to(start * SECTOR)
        length = sectors * SECTOR
        with open(f"{outdir}/p{i}.img", "wb") as out:
            left = length
            while left:
                b = src.read(min(MIB, left))
                if b == zero[: len(b)]:
                    out.seek(len(b), 1)  # leave a hole
                else:
                    out.write(b)
                left -= len(b)
            out.truncate(length)
        print(f"p{i} {start} {sectors}")


def crc(b):
    return zlib.crc32(b) & 0xFFFFFFFF


def name_of(e):
    return e[5].decode("utf-16-le").rstrip("\0")


def header_bytes(fields, sector=SECTOR):
    h = bytearray(HDR.pack(*fields))
    struct.pack_into("<I", h, 16, 0)
    struct.pack_into("<I", h, 16, crc(h))
    return bytes(h) + bytes(sector - HDR.size)


def lun_plan(gpt_file, ss, esp_bytes, boot_bytes, root_bytes, outdir):
    ss, esp_bytes, boot_bytes, root_bytes = int(ss), int(esp_bytes), int(boot_bytes), int(root_bytes)
    d = open(gpt_file, "rb").read()
    if len(d) < 2 * ss:
        fail("the partition table read from the board is too short")
    h = list(HDR.unpack_from(d, ss))
    sig, _, hsize, hcrc, _, my_lba, alt_lba, _, _, _, ent_lba, n, esz, ecrc = h
    if sig != b"EFI PART" or hsize != 92 or my_lba != 1 or esz != 128:
        fail("the board's LUN has no valid GPT; flash the vendor image once first")
    check = bytearray(d[ss:ss + 92])
    struct.pack_into("<I", check, 16, 0)
    if crc(check) != hcrc:
        fail("the board's GPT header checksum is wrong")
    if ent_lba * ss + n * esz > len(d):
        fail("the partition table read from the board is too short")
    raw = d[ent_lba * ss: ent_lba * ss + n * esz]
    if crc(raw) != ecrc:
        fail("the board's GPT entry checksum is wrong")
    names = [name_of(ENT.unpack_from(raw, i * esz)) for i in range(n)
             if raw[i * esz: i * esz + 16] != bytes(16)]
    firmware = [x for x in names if FIRMWARE_RE.match(x)]
    if firmware:
        fail(f"this LUN holds firmware partitions ({', '.join(firmware)}); not replacing it")

    ent_sectors = (n * esz + ss - 1) // ss
    first, last = 2 + ent_sectors, alt_lba - ent_sectors - 1
    align = max(1, MIB // ss)
    up = lambda x: (x + align - 1) // align * align
    secs = lambda b: (b + ss - 1) // ss
    esp_start = up(first)
    boot_start = up(esp_start + secs(esp_bytes))
    root_start = up(boot_start + secs(boot_bytes))
    if last - root_start + 1 < secs(root_bytes):
        fail("the LUN is too small for this image")

    parts = [(ESP_TYPE, esp_start, esp_start + secs(esp_bytes) - 1, "efi"),
             (XBOOTLDR_TYPE, boot_start, boot_start + secs(boot_bytes) - 1, "boot"),
             (ROOT_ARM64_TYPE, root_start, last, "system")]
    ents = bytearray(ent_sectors * ss)
    for i, (t, a, b, name) in enumerate(parts):
        ENT.pack_into(ents, i * esz, t.bytes_le, uuid.uuid4().bytes_le, a, b, 0,
                      name.encode("utf-16-le").ljust(72, b"\0"))
    ecrc = crc(bytes(ents[: n * esz]))
    disk_guid = uuid.uuid4().bytes_le
    fields = [b"EFI PART", 0x10000, 92, 0, 0, 1, alt_lba, first, last, disk_guid, 2, n, esz, ecrc]
    pmbr = bytearray(ss)
    struct.pack_into("<B3xB3xII", pmbr, 446, 0, 0xEE, 1, min(alt_lba, 0xFFFFFFFF))
    pmbr[446 + 1:446 + 4] = b"\x00\x02\x00"
    pmbr[446 + 5:446 + 8] = b"\xff\xff\xff"
    pmbr[510:512] = b"\x55\xaa"
    primary = bytes(pmbr) + header_bytes(fields, ss) + bytes(ents)
    b = list(fields)
    b[5], b[6], b[10] = alt_lba, 1, alt_lba - ent_sectors
    backup = bytes(ents) + header_bytes(b, ss)
    open(f"{outdir}/gpt-main.bin", "wb").write(primary)
    open(f"{outdir}/gpt-backup.bin", "wb").write(backup)
    print("ESP_START", esp_start)
    print("BOOT_START", boot_start)
    print("ROOT_START", root_start)
    print("ROOT_SECTORS", last - root_start + 1)
    print("BACKUP_START", alt_lba - ent_sectors)
    print("DISK_SECTORS", alt_lba + 1)


def find_fs(path):
    with open(path, "rb") as f:
        for off in range(0, 64 * MIB, 4096):
            f.seek(off)
            sb = f.read(2048)
            if len(sb) < 2048:
                break
            if sb[:4] == b"XFSB":
                bsize = struct.unpack_from(">I", sb, 4)[0]
                dblocks = struct.unpack_from(">Q", sb, 8)[0]
                label = sb[108:120].rstrip(b"\0").decode(errors="replace") or "-"
                sectsz = struct.unpack_from(">H", sb, 102)[0]
                print("xfs", off, bsize * dblocks, uuid.UUID(bytes=sb[32:48]), label, sectsz)
                return
            if struct.unpack_from("<H", sb, 1024 + 56)[0] == 0xEF53:
                blocks = struct.unpack_from("<I", sb, 1024 + 4)[0]
                bsize = 1024 << struct.unpack_from("<I", sb, 1024 + 24)[0]
                label = sb[1024 + 120:1024 + 136].rstrip(b"\0").decode(errors="replace") or "-"
                print("ext4", off, blocks * bsize, uuid.UUID(bytes=sb[1024 + 104:1024 + 120]), label, bsize)
                return
            f.seek(off + 0x10000)
            bt = f.read(0x1000)
            if bt[0x40:0x48] == b"_BHRfS_M":
                total = struct.unpack_from("<Q", bt, 0x70)[0]
                sectsz = struct.unpack_from("<I", bt, 0x90)[0]
                label = bt[0x12B:0x12B + 256].split(b"\0")[0].decode(errors="replace") or "-"
                print("btrfs", off, total, uuid.UUID(bytes=bt[0x20:0x30]), label.replace(" ", "_"), sectsz)
                return
    fail(f"no file system found in {path}")


def plan(gpt_file, esp_name, root_name, boot_sectors, esp_min, root_min, root_type, outdir):
    boot_sectors, esp_min, root_min = int(boot_sectors), int(esp_min), int(root_min)
    d = open(gpt_file, "rb").read()
    if len(d) < 34 * SECTOR:
        fail("the partition table read from the board is too short")
    h = list(HDR.unpack_from(d, SECTOR))
    sig, _, hsize, hcrc, _, my_lba, alt_lba, first, last, _, ent_lba, n, esz, ecrc = h
    if sig != b"EFI PART" or hsize != 92 or my_lba != 1 or ent_lba != 2 or esz != 128:
        fail("unexpected partition table on the board (not a standard GPT)")
    check = bytearray(d[SECTOR:SECTOR + 92])
    struct.pack_into("<I", check, 16, 0)
    if crc(check) != hcrc:
        fail("the board's GPT header checksum is wrong")
    ent_sectors = (n * esz + SECTOR - 1) // SECTOR
    if 2 + ent_sectors > 34:
        fail("the board's GPT has more partition entries than expected")
    raw = d[ent_lba * SECTOR: ent_lba * SECTOR + n * esz]
    if crc(raw) != ecrc:
        fail("the board's GPT entry checksum is wrong")
    if alt_lba <= last:
        fail("the board's GPT does not describe the whole eMMC")

    entries = [list(ENT.unpack_from(raw, i * esz)) for i in range(n)]
    used = [i for i, e in enumerate(entries) if e[0] != bytes(16)]
    by_name = {}
    for i in used:
        by_name.setdefault(name_of(entries[i]), []).append(i)

    def one(name):
        idx = by_name.get(name, [])
        if len(idx) != 1:
            fail(f"expected exactly one '{name}' partition on the board, found {len(idx)}")
        return idx[0]

    esp, root = one(esp_name), one(root_name)
    rstart = entries[root][2]
    # A board flashed by VFlasher before has [boot][system] at the end: treat
    # both as the OS area again, so re-flashing gives the same layout.
    if "boot" in by_name:
        b = one("boot")
        later = [i for i in used if i not in (b, root) and entries[i][3] >= entries[b][2]]
        if (uuid.UUID(bytes_le=entries[b][0]) != XBOOTLDR_TYPE or entries[b][3] >= rstart or later):
            fail("the board has a 'boot' partition that VFlasher did not create; not changing it")
        rstart = entries[b][2]
        entries[b] = [bytes(16), bytes(16), 0, 0, 0, bytes(72)]
        used.remove(b)
    if uuid.UUID(bytes_le=entries[esp][0]) != ESP_TYPE:
        fail(f"'{esp_name}' is not an EFI system partition")
    esp_size = entries[esp][3] - entries[esp][2] + 1
    if esp_size < esp_min:
        fail(f"'{esp_name}' is too small ({esp_size} < {esp_min} sectors)")
    for i in used:
        if i != root and entries[i][3] >= rstart:
            fail(f"'{root_name}' is not the last partition on the board")

    align = MIB // SECTOR
    boot_start = (rstart + align - 1) // align * align
    root_start = (boot_start + boot_sectors + align - 1) // align * align
    if last - root_start + 1 < root_min:
        fail("the eMMC is too small for this image")
    free = [i for i in range(n) if entries[i][0] == bytes(16)]
    if not free:
        fail("no free partition slot in the board's GPT")

    types = {"lvm": LVM_TYPE, "linux": LINUX_TYPE}
    if root_type not in types:
        fail(f"unknown QDL_ROOT_TYPE '{root_type}'")
    entries[root][0] = types[root_type].bytes_le
    entries[root][2], entries[root][3] = root_start, last
    name = "boot".encode("utf-16-le").ljust(72, b"\0")
    entries[free[0]] = [XBOOTLDR_TYPE.bytes_le, uuid.uuid4().bytes_le, boot_start,
                        boot_start + boot_sectors - 1, 0, name]

    new_raw = b"".join(ENT.pack(*e) for e in entries)
    new_raw += bytes(ent_sectors * SECTOR - len(new_raw))
    h[13] = crc(new_raw[: n * esz])
    primary = d[:SECTOR] + header_bytes(h) + new_raw
    b = list(h)
    b[5], b[6], b[10] = alt_lba, 1, alt_lba - ent_sectors
    backup = new_raw + header_bytes(b)
    open(f"{outdir}/gpt-main.bin", "wb").write(primary)
    open(f"{outdir}/gpt-backup.bin", "wb").write(backup)

    print("ESP_START", entries[esp][2])
    print("BOOT_START", boot_start)
    print("ROOT_START", root_start)
    print("ROOT_SECTORS", last - root_start + 1)
    print("BACKUP_START", alt_lba - ent_sectors)
    print("DISK_SECTORS", alt_lba + 1)


if sys.argv[1] == "split":
    try:
        split(sys.argv[2])
    except OSError as e:
        if e.errno == 28:  # ENOSPC
            fail(f"ran out of disk space in {sys.argv[2]} while unpacking the image")
        raise
elif sys.argv[1] == "plan":
    plan(*sys.argv[2:10])
elif sys.argv[1] == "lun-plan":
    lun_plan(*sys.argv[2:8])
elif sys.argv[1] == "find-fs":
    find_fs(sys.argv[2])
else:
    fail("unknown helper command")
PY

py_helper() { python3 -I -c "$PY_HELPER" "$@"; }

# The firehose programmer is Qualcomm's loader that qdl uploads to the board.
# It is taken from the board vendor's own image archive; only the start of
# the archive is downloaded, and the file is checked against its SHA-256.
fetch_programmer() {
    local cache file part
    cache="$(cache_dir)"
    mkdir -p "$cache"
    file="$cache/firehose-${CONF[QDL_PROGRAMMER_SHA256]:0:16}.elf"
    if [ -f "$file" ] && sha256_ok "$file" "${CONF[QDL_PROGRAMMER_SHA256]}"; then
        printf '%s\n' "$file"; return
    fi
    part="$file.part"
    local host="${CONF[QDL_PROGRAMMER_URL]#*//}"
    host="${host%%/*}"
    info "Fetching the Qualcomm firehose programmer from ${host:-a local file}" >&2
    case "${CONF[QDL_PROGRAMMER_FORMAT]:-tar.zst}" in
        tar.zst)
            need zstd; need tar
            # tar stops once it has the file, which cuts the download short.
            (curl -fsSL "${CONF[QDL_PROGRAMMER_URL]}" | zstd -dcq \
                | tar -xO --occurrence=1 "${CONF[QDL_PROGRAMMER_PATH]}") > "$part" 2>/dev/null || true ;;
        tar.gz)
            need gzip; need tar
            (curl -fsSL "${CONF[QDL_PROGRAMMER_URL]}" | gzip -dc \
                | tar -xO --occurrence=1 "${CONF[QDL_PROGRAMMER_PATH]}") > "$part" 2>/dev/null || true ;;
        elf)
            curl -fsSL -o "$part" "${CONF[QDL_PROGRAMMER_URL]}" || true ;;
        *) die "unsupported QDL_PROGRAMMER_FORMAT '${CONF[QDL_PROGRAMMER_FORMAT]}'" ;;
    esac
    if ! [ -s "$part" ] || ! sha256_ok "$part" "${CONF[QDL_PROGRAMMER_SHA256]}"; then
        rm -f "$part"
        die "could not get a programmer with the expected checksum"
    fi
    mv "$part" "$file"
    printf '%s\n' "$file"
}

edl_present() {
    local d
    for d in /sys/bus/usb/devices/*; do
        [ -r "$d/idVendor" ] || continue
        if [ "$(cat "$d/idVendor")" = 05c6 ] && [ "$(cat "$d/idProduct")" = 9008 ]; then
            return 0
        fi
    done
    return 1
}

# Qualcomm USB devices that are present, as "vendor:product" lines.
qualcomm_usb_devices() {
    local d
    for d in /sys/bus/usb/devices/*; do
        [ -r "$d/idVendor" ] && [ "$(cat "$d/idVendor")" = 05c6 ] && echo "05c6:$(cat "$d/idProduct")"
    done
    return 0
}

# Things on the host that commonly keep qdl from opening an EDL device.
edl_warnings() {
    local d drv name
    for d in /sys/bus/usb/devices/*; do
        [ -r "$d/idVendor" ] && [ "$(cat "$d/idVendor")" = 05c6 ] && [ "$(cat "$d/idProduct")" = 9008 ] || continue
        for drv in "$d":*/driver; do
            [ -e "$drv" ] || continue
            name="$(basename "$(readlink -f "$drv")")"
            case "$name" in
                qcserial|qcaux|option|usb_wwan)
                    warn "the kernel's $name driver has claimed the board, which can stop qdl."
                    warn "if qdl fails, run 'sudo modprobe -r $name' and try again." ;;
            esac
        done
    done
    if command -v systemctl > /dev/null && systemctl is-active --quiet ModemManager 2> /dev/null; then
        warn "ModemManager is running and may grab the board while qdl works."
        warn "if qdl fails, run 'sudo systemctl stop ModemManager' and try again."
    fi
    return 0
}

wait_for_edl() {
    [ "${VFLASHER_TEST:-}" = 1 ] && return 0
    local i seen
    for ((i = 0; i < 300; i++)); do
        if edl_present; then
            edl_warnings
            return 0
        fi
        [ "$i" -eq 0 ] && info "Waiting for a board in EDL mode (USB 05c6:9008)..."
        if [ "$i" -eq 15 ]; then
            seen="$(qualcomm_usb_devices | sort -u | tr '\n' ' ')"
            if [ -n "$seen" ]; then
                warn "a Qualcomm device is connected (${seen% }) but not in EDL mode (05c6:9008)."
                warn "check the EDL switch or jumper, then power-cycle the board."
            else
                warn "no Qualcomm USB device seen yet; check the cable and that it is in the board's USB0 port."
            fi
        fi
        sleep 1
    done
    die "no board in EDL mode found after 5 minutes"
}

# After qdl finishes, the programmer resets the board, which comes back in EDL
# mode while the EDL switch or jumper is still set. Wait for it to drop off
# USB and come back, then give it a moment, so the next qdl session does not
# start on a board that is still resetting.
wait_for_edl_reconnect() {
    [ "${VFLASHER_TEST:-}" = 1 ] && return 0
    local i
    for ((i = 0; i < 30; i++)); do
        edl_present || break
        sleep 0.5
    done
    wait_for_edl
    sleep "${VFLASHER_EDL_SETTLE:-3}"
}

# Insert "devicetree (\$root)/dtb/<DTB>" into the GRUB stubs on the EFI
# partition, right after they locate /boot. /boot/dtb always points at the
# newest kernel's device trees, so this keeps working after kernel updates.
add_devicetree_to_esp() {
    local esp="$1" dtb="$2" f tmp found=0
    need mtype; need mcopy
    tmp="$(dirname "$esp")/stub.cfg"
    for f in ::/EFI/fedora/grub.cfg ::/EFI/BOOT/grub.cfg; do
        MTOOLS_SKIP_CHECK=1 mtype -i "$esp" "$f" > "$tmp" 2>/dev/null || continue
        found=1
        grep -q '^devicetree ' "$tmp" && continue
        awk -v line="devicetree (\$root)/dtb/$dtb" '{ print } /^set prefix=/ { print line }' "$tmp" > "$tmp.new"
        grep -q '^devicetree ' "$tmp.new" || die "unexpected GRUB stub in $f; not changing it"
        MTOOLS_SKIP_CHECK=1 mcopy -o -i "$esp" "$tmp.new" "$f"
    done
    rm -f "$tmp" "$tmp.new"
    [ "$found" -eq 1 ] || die "no GRUB stub found on the image's EFI partition"
}

# qdl job files (Qualcomm rawprogram*.xml format), as Arduino's flasher uses.
# They state the sector size, so qdl need not detect it. The C# app writes the
# same files (windows/src/VFlasher.Core/Qdl/QdlJobXml.cs).
qdl_read_job() { # FILE START SECTORS [SECTOR_SIZE] [LUN]
    printf '<?xml version="1.0" ?>\n<data>\n  <read SECTOR_SIZE_IN_BYTES="%s" filename="%s" physical_partition_number="%s" num_partition_sectors="%s" start_sector="%s"/>\n</data>\n' "${4:-512}" "$1" "${5:-0}" "$3" "$2"
}

qdl_program_line() { # DIR LABEL FILE START [SECTOR_SIZE] [LUN]
    local ss="${5:-512}"
    local sectors=$(( ($(stat -c %s "$1/$3") + ss - 1) / ss ))
    printf '  <program SECTOR_SIZE_IN_BYTES="%s" file_sector_offset="0" filename="%s" label="%s" num_partition_sectors="%s" physical_partition_number="%s" sparse="false" start_sector="%s"/>\n' "$ss" "$3" "$2" "$sectors" "${6:-0}" "$4"
}

# Warn early if the work folder's drive may be too small to unpack the image.
check_unpack_space() { # IMAGE WORK
    local need="" avail
    if [ "${CONF[IMAGE_FORMAT]}" = raw.xz ] && command -v xz > /dev/null; then
        need="$(xz --robot -l "$1" 2> /dev/null | awk '$1 == "totals" { print $5 }')"
    fi
    avail="$(df -B1 --output=avail "$2" 2> /dev/null | tail -n1 | tr -d ' ')"
    [[ $need =~ ^[0-9]+$ && $avail =~ ^[0-9]+$ ]] || return 0
    # The extra 10% covers the rebuilt root file system for 4K-sector storage.
    if [ "$avail" -lt $(( need + need / 10 )) ]; then
        warn "unpacking may need up to $(( (need + need / 10) / 1000000000 )) GB in $(dirname "$2"),"
        warn "which has $(( avail / 1000000000 )) GB free. Empty parts of the image take no space,"
        warn "so it may still fit; if not, free some space or use --cache DIR on a bigger drive."
    fi
}

# Undo mounts and loop devices of a work folder, then delete it.
qdl_cleanup() {
    local work="$1" m f
    for m in "$work"/mnt-*; do
        if mountpoint -q "$m" 2>/dev/null; then umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true; fi
    done
    for f in "$work"/*.img; do
        [ -e "$f" ] || continue
        losetup -j "$f" 2>/dev/null | cut -d: -f1 | while read -r l; do losetup -d "$l" 2>/dev/null || true; done
    done
    rm -rf --one-file-system "$work"
}

# Replace a file's contents in place, keeping its inode (and so its SELinux label).
rewrite_file() { # FILE SED_SCRIPT
    [ -f "$1" ] || return 0
    sed -E "$2" "$1" > "$1.vflasher-tmp" && cat "$1.vflasher-tmp" > "$1" && rm -f "$1.vflasher-tmp"
}

# Add x-systemd.growfs to the root entry in a root file system's fstab, so a
# root kept as is also grows to fill its partition on first boot.
enable_growfs() { # WORK IMAGE OFFSET BYTES FSTYPE
    local work="$1" mnt="$1/mnt-root" l fstab opts=()
    mkdir -p "$mnt"
    l="$(losetup -f --show -o "$3" --sizelimit "$4" "$2")"
    [ "$5" = btrfs ] && opts=(-o subvolid=5)
    [ "$5" = xfs ] && opts=(-o nouuid)
    mount "${opts[@]}" "$l" "$mnt" || { losetup -d "$l"; die "could not mount the image's root file system"; }
    fstab="$(find "$mnt" -maxdepth 3 -path '*/etc/fstab' -type f | head -n1)"
    if [ -n "$fstab" ]; then
        awk '$1 !~ /^#/ && $2 == "/" && $4 !~ /x-systemd\.growfs/ { $4 = $4 ",x-systemd.growfs" } { print }' \
            "$fstab" > "$work/fstab.new" && cat "$work/fstab.new" > "$fstab"
    fi
    umount "$mnt"; losetup -d "$l"
}

# Rebuild the image's partitions for storage with SS-byte sectors (UFS uses
# 4096). FAT and XFS made for 512-byte sectors cannot be mounted on such a
# device; ext4 with 4K blocks works as is. Root on LVM becomes a plain XFS
# partition with the same UUID (no volume group that could clash with the
# host's), set to grow to the whole partition on first boot.
rebuild_for_sector_size() { # WORK SS
    local work="$1" ss="$2"
    local t
    for t in mkfs.vfat mkfs.xfs mcopy minfo losetup mount umount mountpoint; do need "$t"; done
    local mold="$work/mnt-old" mnew="$work/mnt-new" mboot="$work/mnt-boot"
    mkdir -p "$mold" "$mnew" "$mboot"

    info "Rebuilding the EFI partition for ${ss}-byte sectors"
    local info serial label size
    info="$(MTOOLS_SKIP_CHECK=1 minfo -i "$work/p1.img" ::)"
    serial="$(awk -F': ' '/serial number/ { print $2 }' <<<"$info")"
    label="$(sed -n 's/.*disk label="\([^"]*\)".*/\1/p' <<<"$info" | sed 's/ *$//')"
    [[ $serial =~ ^[0-9A-Fa-f]{8}$ ]] || die "could not read the EFI partition's serial number"
    mkdir -p "$work/esp-files"
    MTOOLS_SKIP_CHECK=1 mcopy -s -i "$work/p1.img" '::/*' "$work/esp-files/"
    size=$(stat -c %s "$work/p1.img")
    rm -f "$work/p1.img"
    truncate -s "$size" "$work/p1.img"
    # One sector per cluster; more than 65524 clusters needs FAT32.
    local fat=()
    [ $(( size / ss )) -gt 65524 ] && fat=(-F 32)
    mkfs.vfat -S "$ss" -s 1 "${fat[@]}" -i "$serial" ${label:+-n "$label"} "$work/p1.img" > /dev/null
    MTOOLS_SKIP_CHECK=1 mcopy -s -i "$work/p1.img" "$work/esp-files/"* ::/
    rm -rf "$work/esp-files"

    local fs off fsize uuid fslabel fsec
    read -r fs off fsize uuid fslabel fsec < <(py_helper find-fs "$work/p3.img")
    [ "$fslabel" = - ] && fslabel=""
    case "$fs" in
        xfs) ;;
        ext4|btrfs)
            [ "${fsec:-0}" -ge "$ss" ] || die "the image's $fs root uses ${fsec}-byte blocks; this storage needs $ss"
            info "The $fs root file system already works with ${ss}-byte sectors"
            enable_growfs "$work" "$work/p3.img" "$off" "$fsize" "$fs"
            return ;;
        *) die "unsupported root file system '${fs:-none}'" ;;
    esac
    if [ "${fsec:-0}" -ge "$ss" ]; then
        info "The XFS root file system already works with ${ss}-byte sectors"
        enable_growfs "$work" "$work/p3.img" "$off" "$fsize" xfs
        return
    fi
    info "Rebuilding the root file system for ${ss}-byte sectors"
    local old
    old="$(losetup -f --show -r -o "$off" --sizelimit "$fsize" "$work/p3.img")"
    # nouuid: the old and new file system share a UUID while both are mounted.
    mount -o ro,norecovery,nouuid "$old" "$mold" || die "could not mount the image's root file system"
    truncate -s $(( (fsize + ss - 1) / ss * ss )) "$work/root.img"
    mkfs.xfs -q -f -s size="$ss" -m uuid="$uuid" ${fslabel:+-L "$fslabel"} "$work/root.img"
    mount -o loop,nouuid "$work/root.img" "$mnew" || die "could not mount the new root file system"
    cp -a --preserve=all "$mold/." "$mnew/" || die "copying the root file system failed"

    # Point everything that named the LVM volume at the file system's UUID.
    local old_root mapper=""
    old_root="$(awk '$1 !~ /^#/ && $2 == "/" { print $1 }' "$mnew/etc/fstab")"
    if [[ $old_root =~ ^/dev/([^/]+)/([^/]+)$ && ${BASH_REMATCH[1]} != mapper ]]; then
        local vg="${BASH_REMATCH[1]}" lv="${BASH_REMATCH[2]}"
        mapper="/dev/mapper/${vg//-/--}-${lv//-/--}"
    fi
    local fix="s# ?rd\.lvm\.lv=[^ \"]+##g"
    [ -n "$old_root" ] && fix="$fix; s#root=${old_root}( |\"|\$)#root=UUID=${uuid}\1#g"
    [ -n "$mapper" ] && fix="$fix; s#root=${mapper}( |\"|\$)#root=UUID=${uuid}\1#g"
    awk -v u="UUID=$uuid" '$1 !~ /^#/ && $2 == "/" { $1 = u; if ($4 !~ /x-systemd\.growfs/) $4 = $4 ",x-systemd.growfs" } { print }' \
        "$mnew/etc/fstab" > "$work/fstab.new" && cat "$work/fstab.new" > "$mnew/etc/fstab"
    rewrite_file "$mnew/etc/kernel/cmdline" "$fix"
    rm -f "$mnew/etc/lvm/devices/system.devices" "$mnew/etc/lvm/devices/auto-import-rootvg"
    umount "$mnew"; umount "$mold"; losetup -d "$old"
    mv "$work/root.img" "$work/p3.img"

    mount -o loop "$work/p2.img" "$mboot" || die "could not mount the image's /boot"
    rewrite_file "$mboot/grub2/grub.cfg" "$fix"
    for t in "$mboot"/loader/entries/*.conf; do rewrite_file "$t" "$fix"; done
    umount "$mboot"
}

flash_qdl() {
    local image="$1" assume_yes="$2"
    local storage="${CONF[QDL_STORAGE]:-emmc}" esp_name="${CONF[QDL_ESP_PARTITION]:-efi}"
    local root_name="${CONF[QDL_ROOT_PARTITION]:-system}"
    local layout="${CONF[QDL_LAYOUT]:-keep-firmware}" ss="${CONF[QDL_SECTOR_SIZE]:-512}" lun="${CONF[QDL_LUN]:-0}"
    case "$layout" in
        keep-firmware) [ "$ss" = 512 ] || die "QDL_LAYOUT=keep-firmware needs QDL_SECTOR_SIZE=512" ;;
        whole-lun) [[ $ss =~ ^(512|4096)$ && $lun =~ ^[0-9]$ ]] || die "bad QDL_SECTOR_SIZE or QDL_LUN" ;;
        *) die "unknown QDL_LAYOUT '$layout'" ;;
    esac
    local n
    for n in "$storage" "$esp_name" "$root_name"; do
        [[ $n =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid partition or storage name '$n' in manifest"
    done
    need python3; need awk; need stat
    [ "$QDL" != qdl ] || need qdl
    [ "${VFLASHER_TEST:-}" = 1 ] || [ -d /sys/bus/usb/devices ] || die "cannot see USB devices (/sys/bus/usb)"

    local prog; prog="$(fetch_programmer)"

    local work
    work="$(mktemp -d "$(cache_dir)/work.XXXXXX")"
    # shellcheck disable=SC2064
    trap "qdl_cleanup '$work'" EXIT

    info "Unpacking the image's partitions"
    local unpack; unpack="$(decompress_cmd)"
    local -a parts=()
    local name sectors
    # shellcheck disable=SC2086
    check_unpack_space "$image" "$work"
    # shellcheck disable=SC2086
    if ! $unpack "$image" | py_helper split "$work" > "$work/parts.txt"; then
        rm -f "$work"/p*.img
        die "could not unpack the image (see the error above). Free some space, or use --cache DIR on a bigger drive."
    fi
    while read -r name _ sectors; do
        parts+=("$name:$sectors")
    done < "$work/parts.txt"
    [ ${#parts[@]} -eq 3 ] || die "expected an image with 3 partitions (EFI, /boot, root), found ${#parts[@]}"
    local esp_sectors="${parts[0]#*:}" boot_sectors="${parts[1]#*:}" root_sectors="${parts[2]#*:}"

    if [ "$ss" != 512 ]; then
        rebuild_for_sector_size "$work" "$ss"
    fi

    if [ -n "${CONF[DTB]:-}" ]; then
        info "Setting the device tree to ${CONF[DTB]}"
        add_devicetree_to_esp "$work/p1.img" "${CONF[DTB]}"
    fi

    echo
    if [ "$layout" = whole-lun ]; then
        echo "VFlasher will replace LUN $lun of the board's $storage with ${CONF[NAME]}."
        echo "The firmware on the other LUNs is kept."
    else
        echo "VFlasher will replace the OS partitions on the board's $storage with ${CONF[NAME]}."
        echo "The firmware partitions are kept."
    fi
    echo "The current OS on the board will be ERASED."
    if [ "$assume_yes" -eq 0 ]; then
        local answer=""
        ask "Type 'yes' to continue: " answer
        [ "$answer" = yes ] || die "aborted"
    fi

    echo
    echo "Put the board in EDL mode and connect it to this computer over USB-C."
    local hint="${CONF[EDL_HINT]:-}"
    echo "${hint:-See the documentation of the board for how to enter EDL mode.}"
    if [ "$assume_yes" -eq 0 ]; then
        # shellcheck disable=SC2034  # the answer is not needed
        local dummy=""
        ask "Press Enter when the board is connected in EDL mode..." dummy
    fi
    wait_for_edl

    info "Reading the board's partition table"
    local read_sectors=34
    [ "$layout" = whole-lun ] && read_sectors=$(( 2 + (16384 + ss - 1) / ss ))
    qdl_read_job board-gpt.bin 0 "$read_sectors" "$ss" "$lun" > "$work/read-gpt.xml"
    (cd "$work" && "$QDL" --storage "$storage" "$prog" read-gpt.xml) \
        || die "qdl could not read the board (is it in EDL mode?)"

    local -A plan=()
    local key val
    if [ "$layout" = whole-lun ]; then
        esp_name=efi root_name=system
        while read -r key val; do plan[$key]="$val"; done < <(
            py_helper lun-plan "$work/board-gpt.bin" "$ss" "$(stat -c %s "$work/p1.img")" \
                "$(stat -c %s "$work/p2.img")" "$(stat -c %s "$work/p3.img")" "$work")
    else
        while read -r key val; do plan[$key]="$val"; done < <(
            py_helper plan "$work/board-gpt.bin" "$esp_name" "$root_name" \
                "$boot_sectors" "$esp_sectors" "$root_sectors" "${CONF[QDL_ROOT_TYPE]:-linux}" "$work")
    fi
    [ -n "${plan[ROOT_START]:-}" ] || die "could not plan the new partition layout"

    echo
    echo "Writing ${CONF[NAME]} to the board's $storage:"
    printf '  %-8s at sector %-10s (%s)\n' "$esp_name" "${plan[ESP_START]}" "EFI system partition" \
        boot "${plan[BOOT_START]}" "/boot" \
        "$root_name" "${plan[ROOT_START]}" "root, $(( plan[ROOT_SECTORS] * ss / 1024 / 1024 / 1024 )) GiB"

    wait_for_edl_reconnect
    info "Flashing (this takes a while; do not disconnect the board)"
    # The partitions first, the new partition table last.
    {
        printf '<?xml version="1.0" ?>\n<data>\n'
        qdl_program_line "$work" "$esp_name" p1.img "${plan[ESP_START]}" "$ss" "$lun"
        qdl_program_line "$work" boot p2.img "${plan[BOOT_START]}" "$ss" "$lun"
        qdl_program_line "$work" "$root_name" p3.img "${plan[ROOT_START]}" "$ss" "$lun"
        qdl_program_line "$work" BackupGPT gpt-backup.bin "${plan[BACKUP_START]}" "$ss" "$lun"
        qdl_program_line "$work" PrimaryGPT gpt-main.bin 0 "$ss" "$lun"
        printf '</data>\n'
    } > "$work/rawprogram.xml"
    # Retrying is safe: the job rewrites the same partitions and writes the
    # partition table last, so a run cut short is simply done again.
    local attempt
    for attempt in 1 2 3; do
        if (cd "$work" && "$QDL" --storage "$storage" "$prog" rawprogram.xml); then
            break
        fi
        [ "$attempt" -lt 3 ] || die "qdl failed while flashing; re-run VFlasher, or restore the vendor image with its own flasher"
        warn "qdl lost the board (attempt $attempt of 3); waiting for it to come back in EDL mode."
        warn "if it does not, power-cycle the board with the EDL switch or jumper still set."
        wait_for_edl_reconnect
    done

    info "Done. ${CONF[NAME]} is on the board."
    echo "Take the board out of EDL mode (jumper or switch) and power-cycle it."
    if [ -n "${CONF[FIRST_BOOT]:-}" ]; then
        echo "After the first login, run this to use the whole $storage:"
        echo "  ${CONF[FIRST_BOOT]}"
    fi
}

# -------------------------------------------------------------------- main

main() {
    local device="" assume_yes=0 download_only=0 info_only=0
    local -a pos=()

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)       usage; exit 0 ;;
            -V|--version)    echo "vflasher $VFLASHER_VERSION"; exit 0 ;;
            -l|--list)       list_images; exit 0 ;;
            -d|--device)     [ $# -ge 2 ] || die "$1 needs an argument"; device="$2"; shift ;;
            --device=*)      device="${1#*=}" ;;
            -y|--yes)        assume_yes=1 ;;
            --download-only) download_only=1 ;;
            --cache)         [ $# -ge 2 ] || die "$1 needs an argument"; VFLASHER_CACHE="$(realpath -m "$2")"; shift ;;
            --cache=*)       VFLASHER_CACHE="$(realpath -m "${1#*=}")" ;;
            --info)          info_only=1 ;;
            -*)              die "unknown option $1 (see --help)" ;;
            *)               pos+=("$(tr '[:upper:]' '[:lower:]' <<<"$1")") ;;
        esac
        shift
    done

    [ ${#pos[@]} -eq 3 ] || { usage >&2; exit 2; }
    local p
    for p in "${pos[@]}"; do valid_name "$p" || die "invalid name '$p'"; done

    find_conf "${pos[@]}"
    load_conf "$CONF_PATH"
    if [ "$REMOTE_CONF" -eq 1 ]; then rm -f "$CONF_PATH"; fi

    if [ "$info_only" -eq 1 ]; then show_info; exit 0; fi

    local method="${CONF[FLASH_METHOD]}"
    case "$method" in
        dd) ;;
        qdl) [ -z "$device" ] || die "--device is not used for this board; it is flashed over USB in EDL mode" ;;
        *) die "flash method '$method' is not supported by this VFlasher version" ;;
    esac

    # VFLASHER_TEST=1 is used by tests/, which flash a disk-image file instead of a board.
    if [ "$download_only" -eq 0 ] && [ "$(id -u)" -ne 0 ] && [ "${VFLASHER_TEST:-}" != 1 ]; then
        die "flashing needs root; run with sudo (or use --download-only)"
    fi

    need sha256sum
    info "${CONF[NAME]}"

    # Pick and check the target before a possibly long download.
    if [ "$download_only" -eq 0 ] && [ "$method" = dd ]; then
        need lsblk; need dd
        [ -n "$device" ] || device="$(pick_device)"
        [ -n "$device" ] || die "no device given"
        check_device "$device"
    fi

    local image; image="$(fetch_image)"
    if [ "$download_only" -eq 1 ]; then
        info "Image verified: $image"
        exit 0
    fi

    if [ "$method" = qdl ]; then
        flash_qdl "$image" "$assume_yes"
        return
    fi

    if [ "$assume_yes" -eq 0 ]; then
        echo
        lsblk -po NAME,SIZE,TYPE,MODEL "$device"
        echo
        echo "ALL DATA ON $device WILL BE DESTROYED."
        local answer=""
        ask "Type the device name ($device) to continue: " answer
        [ "$answer" = "$device" ] || die "aborted"
    fi

    flash_dd "$image" "$device"
}

main "$@"
